# ============================================
# ITSD Reminder Bot - Configuration Template
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================

# ===================
# REQUIRED SETTINGS
# ===================

# Slack Bot Token (starts with xoxb-)
# Get this from: https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack Channel ID to monitor
# Right-click on channel → View channel details → Copy Channel ID
CHANNEL_ID=C0XXXXXXXXX

# HelpDesk Bot ID
# Find this by looking at HelpDesk bot messages in Slack
HELPDESK_BOT_ID=B0XXXXXXXXX

# ===================
# OPTIONAL SETTINGS
# ===================

# Time threshold before sending a reminder (in seconds)
# Default: 10800 (3 hours)
AGE_THRESHOLD_SECONDS=10800

# Interval between checks (in hours)
# Default: 2
CHECK_INTERVAL_HOURS=2

# Path to the reminded messages log file
# Default: /app/data/reminded_messages.json (for Docker)
# REMINDER_LOG_FILE=/app/data/reminded_messages.json

# Custom reminder message (use {user} as placeholder for the user mention)
# REMINDER_MESSAGE=👋 Hi <@{user}>, you've started a ticket but forgot the category! Help us help you, select one to get things moving.

# File the main loop touches every 15 minutes; the container is unhealthy if it
# is older than 30 minutes. The Dockerfile and docker-compose.yml health checks
# read /tmp/itsd-reminder.heartbeat, so leave this unset when running in Docker.
# HEARTBEAT_FILE=/tmp/itsd-reminder.heartbeat
